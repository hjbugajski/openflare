# OpenFlare (.env)
# Copy to .env, then fill the required values.
#
# Quick start (local):
#   1) APP_KEY=$(php artisan key:generate --show)
#   2) composer run dev
#
# Quick start (production):
#   - Set the Required vars below
#   - Run migrations + start queue worker + scheduler
#   - SQLite persistence: set DB_DATABASE=/data/database.sqlite (mount /data)

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
# Production deployments must explicitly set APP_ENV=production; the app
# fails fast in production with default/empty Reverb credentials (see
# AppServiceProvider::validateProductionSecuritySettings).

APP_KEY=
# Generate with: php artisan key:generate --show

APP_URL=http://localhost:8000

REVERB_APP_KEY=openflare-key
REVERB_APP_SECRET=openflare-secret
# Generate secure values for production:
#   openssl rand -hex 16  (REVERB_APP_KEY)
#   openssl rand -hex 32  (REVERB_APP_SECRET)
# Reverb host/port/scheme are derived from APP_URL.

# ------------------------------------------------------------------------------
# Optional (proxies)
# ------------------------------------------------------------------------------

# TRUSTED_PROXIES=
# Comma-separated IPs/CIDRs whose X-Forwarded-* headers are trusted, or "*" to
# trust every proxy. Empty (default) trusts none: X-Forwarded-For is ignored, so
# a spoofed header cannot shard the login rate limiter.
# Set this when a proxy terminates TLS in front of the app (Railway, Docker
# image behind a platform edge); otherwise the client IP and HTTPS scheme are
# read from the proxy's own connection. The platform edge address is rarely
# stable, so use its private network range (e.g. TRUSTED_PROXIES=10.0.0.0/8),
# or TRUSTED_PROXIES=* only when the app is reachable exclusively through that
# proxy — "*" makes X-Forwarded-For fully client-controlled otherwise.

# ------------------------------------------------------------------------------
# Optional (email notifications)
# ------------------------------------------------------------------------------

MAIL_MAILER=log
# log (default) or resend

MAIL_FROM_ADDRESS=hello@example.com

RESEND_API_KEY=
# Required when MAIL_MAILER=resend

# ------------------------------------------------------------------------------
# Optional (database)
# ------------------------------------------------------------------------------

# DB_CONNECTION=sqlite
# sqlite (default) or pgsql

# DB_DATABASE=
# SQLite default: database/database.sqlite
# Production (persistent volume): /data/database.sqlite

# SQLite tuning (reduce "database is locked" errors)
# SQLITE_BUSY_TIMEOUT=5000
# SQLITE_JOURNAL_MODE=wal
# SQLITE_SYNCHRONOUS=normal

# DATABASE_URL=
# PostgreSQL URL (alternative to DB_* vars)

# ------------------------------------------------------------------------------
# Optional (monitors)
# ------------------------------------------------------------------------------

# MONITORS_TEST_MODE=false
# MONITORS_DISPATCH_LIMIT=500
# MONITORS_RETENTION_DAYS=30
# MONITORS_MAX_PER_USER=100
# MONITORS_FAILURE_CONFIRMATION_THRESHOLD=3
# MONITORS_RECOVERY_CONFIRMATION_THRESHOLD=3

# ------------------------------------------------------------------------------
# Optional (frontend)
# ------------------------------------------------------------------------------

INERTIA_ENCRYPT_HISTORY=true
# Encrypts page props in the browser's history state so secrets (TOTP secret,
# recovery codes) are unreadable after logout. Set to false only for debugging.
